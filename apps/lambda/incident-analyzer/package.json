{
  "name": "incident-analyzer",
  "version": "0.0.1",
  "description": "QuizSnapshotFailure ALARM 발생 시 Metrics/Logs/X-Ray Trace를 수집해 OpenAI로 장애 원인 후보를 분석하고 Slack으로 전달하는 Lambda",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "yarn typecheck && node esbuild.config.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest"
  },
  "dependencies": {
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch": "^3.700.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/client-xray": "^3.700.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.5.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
