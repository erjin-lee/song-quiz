# 부하 테스트 설정값. 여기 있는 값이 곧 기본값이다.
#
# 사용법
#   cp .env.example .env      (yarn load:* 가 없으면 자동으로 만들어준다)
#   vi .env                   → LOAD_TARGET / LOAD_QUIZ_ID 를 환경에 맞게 고친다
#
# 우선순위: 명령줄 환경변수 > .env > 코드 기본값(processors/game.ts)
#   LOAD_CONCURRENT_USERS=100 yarn load:step   ← 이렇게 주면 .env 값보다 우선한다
#   그래서 단계별 테스트는 .env를 고치지 않고 명령줄로만 바꿔가며 돌리면 된다.
#
# ⚠️ 이 파일에는 비밀값을 넣지 않는다. 여기 있는 것은 전부 부하 크기/시간 튜너블이며,
#    방 생성·입장은 게스트 경로(쿠키 없음)로 동작해 credential 자체가 필요 없다.
#    .env / .env.local 은 .gitignore 대상이고, 이 .env.example 만 커밋된다.

# ── 대상 환경 (여기 둘만 환경마다 다르다) ─────────────────────────────
# apps/game 주소. 로컬은 http://localhost:8002
LOAD_TARGET=http://localhost:8002
# 방을 만들 퀴즈 ID. 출제곡이 실제로 등록된 퀴즈여야 게임이 시작된다.
LOAD_QUIZ_ID=1

# ── 부하 크기 ────────────────────────────────────────────────────────
# 목표 "동시 접속" 수. 누적 VU가 아니라 동시에 붙어 있는 소켓 수다.
# 단계별 테스트: 25 → 50 → 100 → 200 → 300
LOAD_CONCURRENT_USERS=50
# 방당 인원(서버 상한 50). 같은 총원이라도 이 값에 따라 락 경합 강도가 완전히 달라진다.
LOAD_USERS_PER_ROOM=10
# 방 개수는 기본적으로 LOAD_CONCURRENT_USERS / LOAD_USERS_PER_ROOM 으로 자동 계산된다.
# 일부러 불균등하게 만들고 싶을 때만 아래 주석을 풀어 직접 지정한다.
# LOAD_ROOMS=5

# ── 시간 ─────────────────────────────────────────────────────────────
# 전원을 투입하는 데 걸리는 시간(램프업). 이 구간에는 동시 접속이 목표보다 낮다.
LOAD_ARRIVAL_SECONDS=20
# 램프업 후 목표 동시 접속을 유지하는 시간. 실제 측정 구간이다.
LOAD_HOLD_SECONDS=180
# 한 게임의 라운드 수. 게임이 끝나면 방장이 재시작하므로 세션 길이와는 무관하다.
LOAD_SONG_LIMIT=3

# ── spike 전용 (yarn load:spike) ─────────────────────────────────────
# 평상시 구간: 이 인원이 먼저 붙어 게임을 하고 있는다.
SPIKE_BASELINE_USERS=50
SPIKE_BASELINE_SECONDS=30
# 급증 구간: 짧은 시간에 이만큼이 추가로 몰린다(합계 300명).
SPIKE_USERS=250
SPIKE_SECONDS=20

# ── 타임아웃 (보통 그대로 둔다) ───────────────────────────────────────
# 상태 전이 하나를 기다리는 상한. 서버가 느려지면 이 값에 걸려 실패로 기록된다.
LOAD_STATE_TIMEOUT_MS=30000
LOAD_CONNECT_TIMEOUT_MS=10000
